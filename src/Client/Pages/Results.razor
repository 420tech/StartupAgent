@page "/results/{SessionId}"
@using StartupAgent.Client.Services
@using StartupAgent.Shared.Models.Scoring
@using Microsoft.JSInterop
@inject SessionApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject HttpClient Http

<div class="results-container">
    @if (Loading)
    {
        <div class="loading-state">
            <div class="spinner"></div>
            <p>Loading your results...</p>
        </div>
    }
    else if (Error)
    {
        <div class="error-state">
            <h2>Unable to Load Results</h2>
            <p>@ErrorMessage</p>
            <button class="btn-primary" @onclick="RetryLoad">Try Again</button>
        </div>
    }
    else if (DiagnosticResults != null)
    {
        <!-- View Toggle: Founder vs Investor -->
        <div class="view-toggle">
            <button class="toggle-btn @(ViewMode == "founder" ? "active" : "")" 
                    @onclick="@(() => SwitchView("founder"))">
                📊 Founder View
            </button>
            <button class="toggle-btn @(ViewMode == "investor" ? "active" : "")" 
                    @onclick="@(() => SwitchView("investor"))">
                💼 Investor Risk Brief
            </button>
        </div>

        <div class="results-header">
            <h1>@(ViewMode == "investor" ? "Investor Risk Brief" : "Your Diagnostic Results")</h1>
            <p class="timestamp">Completed on @DiagnosticResults.GeneratedAt.ToString("MMMM d, yyyy")</p>
            
            <!-- Download Roadmap Button -->
            <div class="action-buttons">
                <button class="btn-download" @onclick="DownloadRoadmapPdf" disabled="@DownloadingPdf">
                    @if (DownloadingPdf)
                    {
                        <span class="spinner-small"></span>
                        <span>Generating PDF...</span>
                    }
                    else
                    {
                        <span>📄 Download 90-Day Roadmap</span>
                    }
                </button>
                @if (!string.IsNullOrEmpty(DownloadError))
                {
                    <div class="download-error">
                        <p>@DownloadError</p>
                        <button class="btn-retry" @onclick="DownloadRoadmapPdf">Try Again</button>
                    </div>
                }
                @if (ViewMode == "investor")
                {
                    <button class="btn-print" @onclick="PrintInvestorBrief">
                        🖨️ Print Risk Brief
                    </button>
                }
            </div>
        </div>

        @if (ViewMode == "founder")
        {
            <!-- FOUNDER VIEW -->
        <div class="overall-score-card">
            <div class="score-display">
                <div class="score-number">@DiagnosticResults.OverallScore</div>
                <div class="score-label">Overall Readiness</div>
            </div>
            <div class="score-status">
                <span class="status-badge @DiagnosticResults.OverallStatus.ToLower()">
                    @GetStatusLabel(DiagnosticResults.OverallStatus)
                </span>
                <p class="status-text">@GetStatusExplanation(DiagnosticResults.OverallStatus)</p>
            </div>
        </div>

        <!-- Personal Narrative from Tim -->
        @if (!string.IsNullOrEmpty(DiagnosticResults.Narrative))
        {
            <div class="narrative-section">
                <div class="narrative-header">
                    <h2>📬 A Note from Tim</h2>
                    <span class="mindset-tag">@GetMindsetLabel(DiagnosticResults.MindsetBucket)</span>
                </div>
                <div class="narrative-content">
                    @foreach (var paragraph in DiagnosticResults.Narrative.Split("\n\n"))
                    {
                        <p>@paragraph</p>
                    }
                </div>
            </div>
        }

        <!-- Dimension Scores Grid or Drill-Down View -->
        @if (SelectedDimension == null)
        {
            <div class="dimensions-section">
                <h2>Assessment Breakdown</h2>
                <p class="section-hint">Click any dimension to see detailed evidence and recommendations</p>
                <div class="dimensions-grid">
                    @foreach (var dimension in DiagnosticResults.DimensionScores)
                    {
                        <div class="dimension-card clickable" @onclick="@(() => ViewDimensionDetails(dimension))">
                            <div class="dimension-header">
                                <h3>@dimension.DimensionName</h3>
                                <span class="status-badge @dimension.Status.ToLower()">
                                    @GetStatusLabel(dimension.Status)
                                </span>
                            </div>
                            
                            <div class="dimension-score">
                                <div class="score-bar">
                                    <div class="score-fill" style="width: @dimension.Score%"></div>
                                </div>
                                <div class="score-number">@dimension.Score</div>
                            </div>

                            <div class="confidence-note">
                                <strong>Assessment:</strong> @dimension.ConfidenceNote
                            </div>

                            <div class="view-details-hint">
                                Click to view evidence & recommendations →
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Drill-Down Detail View -->
            <div class="dimension-detail-view">
                <button class="btn-back" @onclick="BackToOverview">
                    ← Back to Overview
                </button>

                <div class="detail-header">
                    <div class="detail-title-row">
                        <h2>@SelectedDimension.DimensionName</h2>
                        <span class="status-badge @SelectedDimension.Status.ToLower() large">
                            @GetStatusLabel(SelectedDimension.Status)
                        </span>
                    </div>
                    
                    <div class="detail-score-display">
                        <div class="score-circle">
                            <div class="score-value">@SelectedDimension.Score</div>
                            <div class="score-max">/ 100</div>
                        </div>
                        <div class="confidence-info">
                            <div class="confidence-label">Confidence Level</div>
                            <div class="confidence-value">@SelectedDimension.ConfidenceLevel%</div>
                            <p class="confidence-description">@SelectedDimension.ConfidenceNote</p>
                        </div>
                    </div>
                </div>

                <!-- Evidence Section -->
                @if (SelectedDimension.EvidenceExcerpts.Any())
                {
                    <div class="evidence-section">
                        <h3>📋 Evidence from Your Answers</h3>
                        <div class="evidence-list">
                            @foreach (var evidence in SelectedDimension.EvidenceExcerpts)
                            {
                                <div class="evidence-item">
                                    <span class="evidence-quote">"</span>
                                    <p>@evidence</p>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Risks and Opportunities -->
                @if (SelectedDimension.RisksAndOpportunities.Any())
                {
                    <div class="insights-section">
                        <h3>💡 Key Insights & Recommendations</h3>
                        <div class="insights-list">
                            @foreach (var insight in SelectedDimension.RisksAndOpportunities)
                            {
                                <div class="insight-item @GetInsightType(insight)">
                                    <div class="insight-icon">@GetInsightIcon(insight)</div>
                                    <p>@insight</p>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="no-insights">
                        <p>No specific risks or opportunities identified for this dimension.</p>
                    </div>
                }

                <!-- Next Steps -->
                <div class="next-steps-section">
                    <h3>🎯 Recommended Next Steps</h3>
                    <ol class="next-steps-list">
                        @foreach (var step in GetRecommendedSteps(SelectedDimension))
                        {
                            <li>@step</li>
                        }
                    </ol>
                </div>

                <button class="btn-primary btn-full" @onclick="BackToOverview">
                    Return to Full Results
                </button>
            </div>
        }

        <!-- Top Priorities Section -->
        @if (DiagnosticResults.TopPriorities.Any())
        {
            <div class="priorities-section">
                <h2>Your Top Priorities</h2>
                <ol class="priorities-list">
                    @foreach (var priority in DiagnosticResults.TopPriorities)
                    {
                        <li>
                            <strong>@priority</strong>
                            <p>Focus on improving this area first for maximum impact.</p>
                        </li>
                    }
                </ol>
            </div>
        }
        }
        else
        {
            <!-- INVESTOR RISK BRIEF VIEW -->
            <div class="investor-brief-container">
                
                <!-- Executive Summary -->
                <div class="investor-section">
                    <h2>Executive Summary</h2>
                    <div class="risk-summary">
                        <div class="risk-score-display">
                            <div class="risk-number @GetRiskClass(DiagnosticResults.OverallScore)">
                                @DiagnosticResults.OverallScore
                            </div>
                            <div class="risk-label">Readiness Score</div>
                            <div class="risk-status @DiagnosticResults.OverallStatus.ToLower()">
                                @GetInvestorStatusLabel(DiagnosticResults.OverallStatus)
                            </div>
                        </div>
                        <div class="risk-context">
                            <p class="summary-text">@GetInvestorSummary(DiagnosticResults.OverallStatus, DiagnosticResults.OverallScore)</p>
                            <div class="confidence-indicator">
                                <strong>Assessment Confidence:</strong> @DiagnosticResults.OverallConfidence%
                                <span class="confidence-note">Based on @DiagnosticResults.QuestionsAnswered comprehensive questions</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Critical Risk Areas -->
                <div class="investor-section">
                    <h2>Critical Risk Areas</h2>
                    @{
                        var criticalAreas = DiagnosticResults.DimensionScores.Where(d => d.Status == "Red").ToList();
                        var warningAreas = DiagnosticResults.DimensionScores.Where(d => d.Status == "Yellow").ToList();
                    }
                    
                    @if (criticalAreas.Any())
                    {
                        <div class="risk-category critical">
                            <h3>🔴 Critical Gaps (Immediate Attention Required)</h3>
                            @foreach (var dimension in criticalAreas)
                            {
                                <div class="risk-item">
                                    <div class="risk-header">
                                        <strong>@dimension.DimensionName</strong>
                                        <span class="score-badge red">@dimension.Score/100</span>
                                    </div>
                                    <div class="risk-details">
                                        <p class="assessment">@dimension.ConfidenceNote</p>
                                        @if (dimension.RisksAndOpportunities.Any())
                                        {
                                            <ul class="risk-list">
                                                @foreach (var risk in dimension.RisksAndOpportunities.Where(r => r.Contains("✗") || r.Contains("⚠")))
                                                {
                                                    <li>@risk.Replace("✗", "").Replace("⚠", "").Trim()</li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    @if (warningAreas.Any())
                    {
                        <div class="risk-category warning">
                            <h3>⚠️ Areas of Concern (Monitor Closely)</h3>
                            @foreach (var dimension in warningAreas)
                            {
                                <div class="risk-item">
                                    <div class="risk-header">
                                        <strong>@dimension.DimensionName</strong>
                                        <span class="score-badge yellow">@dimension.Score/100</span>
                                    </div>
                                    <div class="risk-details">
                                        <p class="assessment">@dimension.ConfidenceNote</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    
                    @if (!criticalAreas.Any() && !warningAreas.Any())
                    {
                        <div class="no-critical-risks">
                            <p>✓ No critical risk areas identified. All dimensions score Green.</p>
                        </div>
                    }
                </div>

                <!-- Strengths & Differentiators -->
                <div class="investor-section">
                    <h2>Strengths & Differentiators</h2>
                    @{
                        var strengths = DiagnosticResults.DimensionScores.Where(d => d.Status == "Green").ToList();
                    }
                    
                    @if (strengths.Any())
                    {
                        <div class="strengths-grid">
                            @foreach (var dimension in strengths)
                            {
                                <div class="strength-card">
                                    <div class="strength-header">
                                        <span class="check-icon">✓</span>
                                        <strong>@dimension.DimensionName</strong>
                                    </div>
                                    <div class="strength-score">@dimension.Score/100</div>
                                    <p class="strength-note">@dimension.ConfidenceNote</p>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="no-strengths">Foundational work needed across all assessed dimensions.</p>
                    }
                </div>

                <!-- Dimension Risk Matrix -->
                <div class="investor-section">
                    <h2>Comprehensive Risk Matrix</h2>
                    <div class="risk-matrix">
                        <table class="matrix-table">
                            <thead>
                                <tr>
                                    <th>Dimension</th>
                                    <th>Score</th>
                                    <th>Status</th>
                                    <th>Confidence</th>
                                    <th>Key Assessment</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dimension in DiagnosticResults.DimensionScores.OrderBy(d => d.Score))
                                {
                                    <tr class="@dimension.Status.ToLower()">
                                        <td><strong>@dimension.DimensionName</strong></td>
                                        <td class="score-cell">@dimension.Score/100</td>
                                        <td><span class="status-indicator @dimension.Status.ToLower()">@dimension.Status</span></td>
                                        <td>@dimension.ConfidenceLevel%</td>
                                        <td class="assessment-cell">@dimension.ConfidenceNote</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Due Diligence Notes -->
                <div class="investor-section print-break-before">
                    <h2>Due Diligence Considerations</h2>
                    <div class="dd-notes">
                        <div class="dd-item">
                            <strong>Assessment Method:</strong>
                            <p>Comprehensive diagnostic based on TB Software Readiness Framework™, incorporating YC Startup School criteria and Techstars due diligence standards.</p>
                        </div>
                        <div class="dd-item">
                            <strong>Data Quality:</strong>
                            <p>Assessment confidence: @DiagnosticResults.OverallConfidence% based on @DiagnosticResults.QuestionsAnswered questions answered. Responses analyzed for consistency and depth.</p>
                        </div>
                        <div class="dd-item">
                            <strong>Recommended Follow-Up:</strong>
                            <p>@GetDDRecommendation(DiagnosticResults.OverallStatus)</p>
                        </div>
                    </div>
                </div>

                <!-- Footer Note -->
                <div class="investor-footer">
                    <p class="disclaimer">This risk brief is generated from founder-provided information and should be used as one input in the due diligence process. Verify critical claims through independent analysis.</p>
                    <p class="generated-date">Generated: @DiagnosticResults.GeneratedAt.ToString("MMMM d, yyyy 'at' h:mm tt")</p>
                </div>
            </div>
        }

        <!-- Actions - shown in both views but hidden in print for investor view -->
        <div class="results-actions">
            <button class="btn-primary" @onclick="DownloadRoadmap">Download 90-Day Roadmap</button>
            <button class="btn-secondary" @onclick="ViewInvestorBrief">View Investor Brief</button>
            <button class="btn-secondary" @onclick="BookCall">Book Strategy Call</button>
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No results available yet. Complete your diagnostic to see results.</p>
        </div>
    }
</div>

@code {
    [Parameter]
    public string? SessionId { get; set; }

    private DiagnosticResults? DiagnosticResults;
    private DimensionScore? SelectedDimension;
    private bool Loading = true;
    private bool Error = false;
    private string ErrorMessage = "";
    private bool DownloadingPdf = false;
    private string DownloadError = "";
    private string ViewMode = "founder"; // "founder" or "investor"

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(SessionId))
        {
            Error = true;
            ErrorMessage = "Invalid session ID";
            Loading = false;
            return;
        }

        await LoadResults();
    }

    private async Task LoadResults()
    {
        Loading = true;
        Error = false;
        ErrorMessage = "";

        try
        {
            // TODO: Call API endpoint
            // DiagnosticResults = await ApiClient.GetResultsAsync(SessionId);
            
            // Placeholder loading with enhanced evidence data
            await Task.Delay(500);
            DiagnosticResults = new DiagnosticResults
            {
                SessionId = SessionId ?? "",
                OverallScore = 68,
                OverallStatus = "Yellow",
                MindsetBucket = "confident-but-unsure",
                GeneratedAt = DateTime.Now,
                OverallConfidence = 85,
                QuestionsAnswered = 23,
                TopPriorities = new() { "Go-to-Market", "Traction" },
                Narrative = "Your instincts are solid—68/100 confirms you're on the right track. But I'm seeing a few places where you could tighten up before they become blockers down the road.\n\nThe gap I'd address first: **Go-to-Market**. You're confident in your vision, and that's good—but this area needs attention before it undermines everything else you've built.\n\nYour confidence isn't misplaced—you've got real strengths. Now let's make sure nothing trips you up when it matters most.",
                DimensionScores = new()
                {
                    new() 
                    { 
                        DimensionName = "Problem Validation", 
                        Score = 82, 
                        Status = "Green", 
                        ConfidenceLevel = 90, 
                        ConfidenceNote = "Strong problem understanding with validated customer pain points.",
                        EvidenceExcerpts = new() 
                        { 
                            "We've conducted 47 customer interviews across 3 market segments",
                            "Customer feedback shows 8/10 rate current solutions as inadequate",
                            "Identified clear willingness to pay for proper solution"
                        },
                        RisksAndOpportunities = new()
                        {
                            "✓ Strong validation foundation established",
                            "⚠ Consider expanding to adjacent verticals for growth",
                            "→ Document insights in structured problem statement"
                        }
                    },
                    new() 
                    { 
                        DimensionName = "User Research", 
                        Score = 75, 
                        Status = "Green", 
                        ConfidenceLevel = 85, 
                        ConfidenceNote = "Good user research foundation with room for systematic tracking.",
                        EvidenceExcerpts = new()
                        {
                            "Regular user testing sessions with 5-10 participants weekly",
                            "Created user personas based on interview data",
                            "Track feature requests in shared spreadsheet"
                        },
                        RisksAndOpportunities = new()
                        {
                            "✓ Consistent research cadence in place",
                            "⚠ Research insights not centralized in product roadmap",
                            "→ Implement structured feedback loop with product team"
                        }
                    },
                    new() 
                    { 
                        DimensionName = "Traction", 
                        Score = 45, 
                        Status = "Red", 
                        ConfidenceLevel = 88, 
                        ConfidenceNote = "Early stage with limited traction - needs focused GTM execution.",
                        EvidenceExcerpts = new()
                        {
                            "12 pilot customers using beta version",
                            "Month-over-month growth at 15% but from small base",
                            "No clear repeatable acquisition channel yet"
                        },
                        RisksAndOpportunities = new()
                        {
                            "✗ Traction below funding thresholds for seed stage",
                            "⚠ Customer acquisition cost not yet measured",
                            "→ Focus on 1-2 channels to establish repeatable motion",
                            "→ Set clear monthly growth targets and track weekly"
                        }
                    },
                }
            };
        }
        catch (Exception ex)
        {
            Error = true;
            ErrorMessage = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task RetryLoad()
    {
        await LoadResults();
    }

    private async Task DownloadRoadmapPdf()
    {
        if (string.IsNullOrEmpty(SessionId)) return;

        DownloadingPdf = true;
        DownloadError = "";
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"/api/v1/diagnostics/{SessionId}/roadmap-pdf");
            
            if (response.IsSuccessStatusCode)
            {
                var pdfBytes = await response.Content.ReadAsByteArrayAsync();
                var fileName = $"StartupAgent-Roadmap-{DateTime.UtcNow:yyyyMMdd}.pdf";
                
                // Trigger browser download using JavaScript interop
                await DownloadFile(fileName, pdfBytes);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                DownloadError = "Failed to generate PDF. Please try again.";
                
                // Log error for telemetry
                Console.Error.WriteLine($"PDF download failed: {response.StatusCode} - {errorContent}");
            }
        }
        catch (Exception ex)
        {
            DownloadError = "Unable to download PDF. Please check your connection and try again.";
            Console.Error.WriteLine($"PDF download exception: {ex.Message}");
        }
        finally
        {
            DownloadingPdf = false;
            StateHasChanged();
        }
    }

    private async Task DownloadFile(string fileName, byte[] fileBytes)
    {
        // Convert to base64 for JavaScript
        var base64 = Convert.ToBase64String(fileBytes);
        var dataUrl = $"data:application/pdf;base64,{base64}";
        
        // Use JavaScript to trigger download
        await JS.InvokeVoidAsync("eval", 
            $@"(function() {{
                const link = document.createElement('a');
                link.href = '{dataUrl}';
                link.download = '{fileName}';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            }})()");
    }

    private void ViewDimensionDetails(DimensionScore dimension)
    {
        SelectedDimension = dimension;
        StateHasChanged();
    }

    private void BackToOverview()
    {
        SelectedDimension = null;
        StateHasChanged();
    }

    private string GetInsightType(string insight)
    {
        if (insight.StartsWith("✓")) return "positive";
        if (insight.StartsWith("⚠")) return "warning";
        if (insight.StartsWith("✗")) return "risk";
        if (insight.StartsWith("→")) return "action";
        return "neutral";
    }

    private string GetInsightIcon(string insight)
    {
        if (insight.StartsWith("✓")) return "✓";
        if (insight.StartsWith("⚠")) return "⚠";
        if (insight.StartsWith("✗")) return "✗";
        if (insight.StartsWith("→")) return "→";
        return "•";
    }

    private List<string> GetRecommendedSteps(DimensionScore dimension)
    {
        // Generate context-specific recommendations based on dimension and score
        var steps = new List<string>();
        
        if (dimension.Status == "Red")
        {
            steps.Add($"Review the evidence and risks identified for {dimension.DimensionName}");
            steps.Add("Prioritize this area in your 90-day roadmap as a critical focus");
            steps.Add("Consider booking a strategy call to develop an action plan");
        }
        else if (dimension.Status == "Yellow")
        {
            steps.Add($"Address the opportunities highlighted in {dimension.DimensionName}");
            steps.Add("Implement tracking and metrics to measure progress");
            steps.Add("Set quarterly milestones to move from Yellow to Green");
        }
        else
        {
            steps.Add($"Maintain strong performance in {dimension.DimensionName}");
            steps.Add("Look for opportunities to level up to best-in-class");
            steps.Add("Share your approach as a strength in investor conversations");
        }

        return steps;
    }

    private string GetStatusLabel(string status) => status switch
    {
        "Green" => "✓ Strong",
        "Yellow" => "△ Needs Work",
        "Red" => "✗ Critical",
        _ => status
    };

    private string GetMindsetLabel(string mindset) => mindset.ToLower() switch
    {
        "overwhelmed" => "For founders feeling overwhelmed",
        "confident-but-unsure" => "For confident founders seeking validation",
        "stuck" => "For founders looking for a breakthrough",
        "pre-fundraise" => "For fundraising preparation",
        _ => "Personalized guidance"
    };

    private string GetStatusExplanation(string status) => status switch
    {
        "Green" => "You're well-positioned in most areas. Focus on your priorities to level up.",
        "Yellow" => "Some solid fundamentals, but clear areas to improve. Let's prioritize.",
        "Red" => "Significant gaps identified. Let's build a focused 90-day plan to close them.",
        _ => "Assessment complete."
    };

    private void SwitchView(string mode)
    {
        ViewMode = mode;
        SelectedDimension = null; // Clear drill-down when switching views
        StateHasChanged();
    }

    private async Task PrintInvestorBrief()
    {
        // Trigger browser print dialog
        await JS.InvokeVoidAsync("print");
    }

    private string GetInvestorStatusLabel(string status) => status switch
    {
        "Green" => "Low Risk - Strong Fundamentals",
        "Yellow" => "Moderate Risk - Attention Needed",
        "Red" => "High Risk - Critical Gaps",
        _ => "Assessment Pending"
    };

    private string GetInvestorSummary(string status, int score) => status switch
    {
        "Green" => $"This startup demonstrates strong fundamentals across assessed dimensions ({score}/100). Due diligence should focus on validating claimed metrics and exploring edge cases in high-performing areas.",
        "Yellow" => $"Mixed performance across key dimensions ({score}/100). Several areas require attention before investment. Recommend focused improvement plan with 60-90 day milestones before committing capital.",
        "Red" => $"Critical gaps identified across multiple dimensions ({score}/100). Significant operational and strategic work needed. Consider advisory support or revisit after demonstrated progress in red-flag areas.",
        _ => "Comprehensive assessment of startup readiness and risk profile."
    };

    private string GetRiskClass(int score) => score switch
    {
        >= 75 => "low-risk",
        >= 50 => "moderate-risk",
        _ => "high-risk"
    };

    private string GetDDRecommendation(string status) => status switch
    {
        "Green" => "Validate claimed traction metrics, review financial model assumptions, and conduct reference calls with customers and advisors. Assess team dynamics through extended conversations.",
        "Yellow" => "Deep dive on yellow/red dimensions with specific questions. Request 30-60-90 day improvement roadmap. Consider conditional term sheet with milestone-based tranches.",
        "Red" => "Recommend operational support (advisor, fractional exec, or incubator) before capital deployment. Revisit investment decision after 90 days of focused improvement.",
        _ => "Standard due diligence process recommended."
    };

    private void DownloadRoadmap()
    {
        // TODO: Trigger roadmap PDF download
        if (!string.IsNullOrEmpty(SessionId))
            Nav.NavigateTo($"/roadmap/{SessionId}/download");
    }

    private void ViewInvestorBrief()
    {
        // TODO: Navigate to investor brief view
        if (!string.IsNullOrEmpty(SessionId))
            Nav.NavigateTo($"/brief/{SessionId}");
    }

    private void BookCall()
    {
        // TODO: Open booking modal or navigate to booking
        if (!string.IsNullOrEmpty(SessionId))
            Nav.NavigateTo($"/book-call?session={SessionId}");
    }
}
